# Copy this file to .env and fill in real values. .env is git-ignored —
# credentials never get committed or baked into the image.

MINIO_ENDPOINT=https://media.yourdomain.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=portfolio-media
MINIO_PUBLIC_URL=https://media.yourdomain.com/portfolio-media

# Any random string. Must match the token in js/media-library-minio.js
# on the portfolio site — it's the shared secret between the browser's
# media picker and this API.
MEDIA_API_TOKEN=

# The portfolio's real origin, so this API only accepts browser requests
# from that domain. "*" works too but is looser than it needs to be.
ALLOWED_ORIGIN=https://glowing-dasik-1b746d.netlify.app
